// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = TeenBrain

// The application's bundle identifier.
//
// Deliberately unchanged. Under the macOS App Sandbox the bundle id decides the
// container path, and the container holds the database that schema v2 migrates
// in place. A new id would silently start an empty app beside the old data.
// Change it only together with a data-migration step.
PRODUCT_BUNDLE_IDENTIFIER = dk.glemtdet.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026. Data forbliver på brugerens egen computer; kun chat sendes til Anthropic.
